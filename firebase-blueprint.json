{
  "entities": {
    "CustomerInquiry": {
      "title": "CustomerInquiry",
      "description": "Customer service booking or inquiry for Borj Al Sharqah car care",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "minLength": 8,
          "maxLength": 20
        },
        "service": {
          "type": "string",
          "maxLength": 100
        },
        "carModel": {
          "type": "string",
          "maxLength": 100
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": ["id", "name", "phone", "service", "createdAt"]
    }
  },
  "firestore": {
    "/inquiries/{inquiryId}": {
      "schema": "CustomerInquiry",
      "description": "Customer service inquiries and car detailing booking requests"
    }
  }
}
